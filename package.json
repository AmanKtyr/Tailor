{
  "name": "@amanktyr/tailor",
  "version": "1.3.0",
  "description": "Unified AI Coding-Agent Engineering Framework. Combining Spec-Driven Development, Adaptive Pragmatism (Lite/Full/Ultra), Progressive Project Memory (.ai/), AST Semantic Code Reuse, and Native Model Context Protocol (MCP) Server for Claude Code, Cursor, Codex, Gemini, Windsurf, Roo Code, and Copilot.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tailor": "dist/cli/bin.js",
    "tailor-mcp": "dist/cli/mcp-bin.js"
  },
  "files": [
    "dist",
    "skills",
    "templates",
    "adapters",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AmanKtyr/Tailor.git"
  },
  "homepage": "https://github.com/AmanKtyr/Tailor#readme",
  "bugs": {
    "url": "https://github.com/AmanKtyr/Tailor/issues"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node benchmarks/scripts/run-benchmarks.js",
    "start": "node dist/cli/bin.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "ai-coding-agent",
    "spec-driven-development",
    "sdd",
    "spec-kit",
    "ponytail",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "cursorrules",
    "antigravity",
    "gemini-cli",
    "windsurf",
    "roo-code",
    "cline",
    "github-copilot",
    "codex",
    "opencode",
    "software-engineering",
    "code-reuse",
    "prompt-engineering",
    "project-memory",
    "constitution",
    "decision-ladder",
    "anti-bloat",
    "token-optimization",
    "architecture-decision-records"
  ],
  "author": "Aman Katyar <https://github.com/AmanKtyr>",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}