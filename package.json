{
  "name": "@amanktyr/tailor",
  "version": "1.3.0",
  "description": "Stop vibe-coding bloat & token waste. Unified AI Coding-Agent & Spec-Driven Development (SDD) framework with AST semantic code reuse, progressive project memory (.ai/), and native MCP server for Claude Code, Cursor, Windsurf, Roo Code, Copilot, Zed, and Antigravity.",
  "type": "module",
  "main": "dist/index.js",
