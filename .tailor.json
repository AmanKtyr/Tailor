{
  "profile": "library",
  "memory": {
    "enabled": true,
    "directory": ".ai",
    "autoUpdate": false
  },
  "security": {
    "level": "high",
    "requireAudit": true,
    "blockOnCritical": true
  },
  "seo": {
    "enabled": false
  },
  "dependencies": {
    "requireAudit": true,
    "allowedLicenses": [
      "MIT",
      "Apache-2.0",
      "BSD-3-Clause",
      "BSD-2-Clause",
      "ISC",
      "0BSD",
      "CC0-1.0",
      "Unlicense"
    ]
  },
  "reuse": {
    "enabled": true,
    "componentDirectories": [
      "src/components",
      "components",
      "src/ui",
      "ui",
      "src/lib",
      "lib",
      "src/utils",
      "utils"
    ],
    "searchDepth": 6
  },
  "ignore": [
    "node_modules",
    ".git",
    "dist",
    "build",
    "coverage",
    ".next",
    ".nuxt",
    ".cache",
    "target",
    "bin",
    "obj"
  ]
}